# Validate the optional shared OMM runtime before enabling the SDK target.
function(photara_validate_omm_runtime)
  if(PHOTARA_OMM_STATIC)
    return()
  endif()
  if(NOT PHOTARA_OMM_RUNTIME)
    get_filename_component(_omm_lib_dir "${PHOTARA_OMM_LIBRARY}" DIRECTORY)
    if(WIN32)
      set(_omm_runtime_names omm-lib.dll omm-sdk.dll)
    elseif(APPLE)
      set(_omm_runtime_names libomm-lib.dylib libomm-sdk.dylib)
    else()
      get_filename_component(_omm_library_name "${PHOTARA_OMM_LIBRARY}" NAME)
      set(_omm_runtime_names "${_omm_library_name}" libomm-lib.so libomm-sdk.so)
    endif()
    # Avoid accidentally selecting an unrelated system SDK or a stale cache result.
    unset(_omm_found_runtime CACHE)
    find_file(_omm_found_runtime NAMES ${_omm_runtime_names}
      PATHS "${PHOTARA_OMM_ROOT}/bin" "${PHOTARA_OMM_ROOT}/bin/Release"
            "${_omm_lib_dir}" "${_omm_lib_dir}/../bin" "${_omm_lib_dir}/../../bin"
      NO_DEFAULT_PATH)
    if(_omm_found_runtime)
      set(PHOTARA_OMM_RUNTIME "${_omm_found_runtime}" CACHE FILEPATH
          "OMM shared library runtime, if used" FORCE)
    endif()
    unset(_omm_found_runtime CACHE)
  endif()
  if(NOT PHOTARA_OMM_RUNTIME OR NOT EXISTS "${PHOTARA_OMM_RUNTIME}" OR
     IS_DIRECTORY "${PHOTARA_OMM_RUNTIME}")
    message(FATAL_ERROR "Shared OMM SDK requires a runtime library. Set PHOTARA_OMM_RUNTIME to the matching DLL/shared library, or use PHOTARA_OMM_STATIC=ON for a static archive. Path: '${PHOTARA_OMM_RUNTIME}'")
  endif()
  file(SIZE "${PHOTARA_OMM_RUNTIME}" _omm_runtime_size)
  if(_omm_runtime_size LESS 64)
    message(FATAL_ERROR "OMM runtime is empty or truncated: ${PHOTARA_OMM_RUNTIME}")
  endif()
  if(WIN32)
    get_filename_component(_omm_runtime_ext "${PHOTARA_OMM_RUNTIME}" EXT)
    string(TOLOWER "${_omm_runtime_ext}" _omm_runtime_ext)
    file(READ "${PHOTARA_OMM_RUNTIME}" _omm_signature LIMIT 2 HEX)
    if(NOT _omm_runtime_ext STREQUAL ".dll" OR NOT _omm_signature STREQUAL "4d5a")
      message(FATAL_ERROR "OMM runtime must be a Windows DLL, not an import/static library: ${PHOTARA_OMM_RUNTIME}")
    endif()
  endif()
endfunction()

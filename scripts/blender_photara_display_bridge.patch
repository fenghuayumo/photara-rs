+class PhotaraBlenderDisplayDriver : public BlenderDisplayDriver {
+ public:
+  using DeviceFill = void (*)(void *, int, const uint8_t *, size_t);
+  DeviceFill fill;
+  PhotaraBlenderDisplayDriver(blender::RenderEngine &engine, blender::Scene &scene,
+                             blender::RegionView3D *region, DeviceFill fill)
+      : BlenderDisplayDriver(engine, scene, region, false), fill(fill) {}
+  GraphicsInteropDevice graphics_interop_get_device() override {
+    GraphicsInteropDevice result;
+    auto uuid = blender::GPU_platform_uuid();
+    auto backend = blender::GPU_backend_get_type();
+    int type = backend == blender::GPU_BACKEND_VULKAN ? 2 :
+               backend == blender::GPU_BACKEND_OPENGL ? 1 : 0;
+    // The receiving module must allocate this vector: Blender uses MEM_* while
+    // the standalone renderer uses malloc/free. Do not cross allocator domains.
+    fill(&result, type, uuid.data(), uuid.size());
+    return result;
+  }
+  std::atomic<unsigned long long> gpu_updates{0}, cpu_maps{0};
+  half4 *map_texture_buffer() override {
+    ++cpu_maps;
+    return BlenderDisplayDriver::map_texture_buffer();
+  }
+  void graphics_interop_update_buffer() override {
+    ++gpu_updates;
+    BlenderDisplayDriver::graphics_interop_update_buffer();
+  }
+};
+
+static PyObject *photara_display_stats(PyObject *, PyObject *capsule)
+{
+  auto *driver = static_cast<PhotaraBlenderDisplayDriver *>(
+      PyCapsule_GetPointer(capsule, "photara.DisplayDriver.consumed"));
+  if (!driver) { return nullptr; }
+  return Py_BuildValue("{sK,sK}", "gpu_updates", driver->gpu_updates.load(),
+                      "cpu_maps", driver->cpu_maps.load());
+}
+
+/* Photara bridge: keep allocation, graphics contexts, fences and shaders in
+ * Blender. Both modules must use the identical session/display_driver.h ABI. */
+static void photara_display_capsule_free(PyObject *capsule)
+{
+  if (PyCapsule_IsValid(capsule, "photara.DisplayDriver.v1.4d9862575ebf7cca")) {
+    delete static_cast<DisplayDriver *>(PyCapsule_GetPointer(capsule, "photara.DisplayDriver.v1.4d9862575ebf7cca"));
+  }
+}
+
+static PyObject *photara_display_create(PyObject *, PyObject *args)
+{
+  PyObject *engine, *scene, *region, *allocator;
+  if (!PyArg_ParseTuple(args, "OOOO", &engine, &scene, &region, &allocator)) { return nullptr; }
+  auto *e = static_cast<blender::RenderEngine *>(PyLong_AsVoidPtr(engine));
+  auto *s = static_cast<blender::Scene *>(PyLong_AsVoidPtr(scene));
+  auto *r = static_cast<blender::RegionView3D *>(PyLong_AsVoidPtr(region));
+  if (PyErr_Occurred()) { return nullptr; }
+  if (!e || !s || !r) { return PyErr_Format(PyExc_ValueError, "Missing Blender viewport pointers"); }
+  auto fill = reinterpret_cast<PhotaraBlenderDisplayDriver::DeviceFill>(
+      PyCapsule_GetPointer(allocator, "photara.DisplayDeviceAllocator.v1"));
+  if (!fill) { return nullptr; }
+  DisplayDriver *driver = new PhotaraBlenderDisplayDriver(*e, *s, r, fill);
+  return PyCapsule_New(driver, "photara.DisplayDriver.v1.4d9862575ebf7cca", photara_display_capsule_free);
+}
+
 static PyMethodDef methods[] = {
